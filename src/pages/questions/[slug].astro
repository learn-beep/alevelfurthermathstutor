---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import Motif from '../../components/Motif.astro';
import Icon from '../../components/Icon.astro';
import Hint from '../../components/Hint.astro';
import { allTopics, questionsForTopic, bookletNote, strandBadge, strandMotif, STRAND_PAPERS } from '../../lib/data';
export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = questionsForTopic(topic.slug);
const years = [...new Set(qs.map((q) => q.year))].sort((a, b) => b - a);
const rated = qs.filter((q) => q.difficulty).length;
const booklet = bookletNote(topic.slug);
const motifKind = strandMotif(topic.strand, topic.slug);
const badge = strandBadge(topic.strand);
const short = topic.name.split(':')[0];
---
<Base title={`${short}: Edexcel Further Maths past-paper questions with mark schemes`} description={`Every Edexcel AS and A-level Further Maths past-paper question on ${short.toLowerCase()} since 2018 (${qs.length} parts, ${topic.marks} marks), with mark schemes and examiner comments.`} context={`topic:${topic.slug}`}>
  <div class="topic-head"><h1>{topic.name} <span class={`badge badge-${badge}`}>{topic.strand}</span></h1><Motif kind={motifKind} /></div>
  <div class="where">
    <dl>
      <dt>Papers</dt><dd>{STRAND_PAPERS[topic.strand]}</dd>
      <dt>Level</dt><dd>{topic.asOrA}</dd>
      <dt>Spec</dt><dd>{topic.statements.map((id, i) => <>{i ? ', ' : ''}<a href={`/spec/${id}/`}>{id}</a></>)}</dd>
      {booklet && <><dt>Booklet</dt><dd>{booklet}</dd></>}
      <dt>Since 2018</dt><dd>{qs.length} question parts, {topic.marks} marks{rated ? `, ${rated} with a difficulty rating from the examiner's report` : ''}</dd>
    </dl>
  </div>

  <p class="muted">Notes, worked examples and practice for this topic are being written by our tutors. The past-paper questions below are ready now: work each one on paper, then open the mark scheme and the examiner's comment.</p>

  <div class="score-note" id="myscore" hidden></div>

  <h2>Past-paper questions</h2>
  <p><a class="btn" href={`/questions/${topic.slug}/print/`}><Icon name="printer" />Print this topic as a pack</a> <span class="muted">questions first, then the mark schemes</span></p>
  <div class="filterbar"><div class="chips" role="group" aria-label="Filter">
    <button class="chip" type="button" aria-pressed="true" data-filter="">All ({qs.length})</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="level:AS">AS</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="level:A level">A level</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="difficulty:Hard">Hard</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="difficulty:Easy">Easy</button>
    {years.slice(0, 3).map((y) => <button class="chip" type="button" aria-pressed="false" data-filter={`year:${y}`}>{y}</button>)}
  </div><div class="count" id="count"></div></div>
  <Hint id="reveal" text="Tap a question to zoom it. Mark scheme and examiner's comment open under each question." />
  {qs.map((q) => <QuestionCard q={q} />)}

  <script define:vars={{ slug: topic.slug }}>
    try { const s = JSON.parse(localStorage.getItem('fmalt-scores') || '{}')[slug]; if (s && s.total) { const el = document.getElementById('myscore'); el.hidden = false; el.innerHTML = `Your practice score on this topic: <strong>${s.earned}/${s.total}</strong> (${Math.round(100 * s.earned / s.total)}%) over ${s.n} question${s.n === 1 ? '' : 's'}. <a href="/practice/">Practise more</a>`; } } catch {}
  </script>
  <script>
    const chips = document.querySelectorAll('.chip[data-filter]');
    const cards = document.querySelectorAll('.qcard');
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      const f = c.getAttribute('data-filter') || '';
      const [key, val] = f.split(':');
      cards.forEach((card) => { card.hidden = !!f && card.getAttribute('data-' + key) !== val; });
      document.getElementById('count').textContent = `Showing ${[...cards].filter((c) => !c.hidden).length} of ${cards.length}`;
    }));
  </script>
</Base>
