---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Hint from '../../components/Hint.astro';
import { allTopics, STRANDS } from '../../lib/data';
const strands = STRANDS;
---
<Base title="Edexcel Further Maths practice: question player with self-marking" description="Pick topics, difficulty and a time limit, work through real Edexcel Further Maths past-paper questions one at a time, then mark yourself against the mark scheme. Scores by topic are saved in your browser." context="practice" leadLine="Keep scoring low on one topic? That's exactly what a tutor fixes fastest.">
  <h1>Practice</h1>
  <p>Pick topics, a difficulty and a time limit. Work each question on paper, open the mark scheme, tick the marks you earned. Your scores by topic are saved in this browser only, and show on each topic page.</p>

  <Hint id="scores" text="Scores are saved in this browser only, no account needed. Clear them any time from the round summary." />
  <div class="panel" id="setup">
    <h3>Topics</h3>
    <div class="chips">{strands.map((s) => <button class="chip" type="button" data-all={s}>All {s}</button>)}<button class="chip" type="button" data-all="">Clear</button></div>
    {strands.map((s) => <><p class="muted small-text" style="margin:.6rem 0 .2rem">{s}</p><div class="chips" data-strand={s}>{allTopics.filter((t) => t.strand === s).map((t) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.name.split(':')[0].split(',')[0]} <span class="muted">({t.parts})</span></button>)}</div></>)}
    <h3>Level</h3>
    <div class="chips" data-group="level"><button class="chip" type="button" data-v="" aria-pressed="true">Both</button><button class="chip" type="button" data-v="AS">AS only</button><button class="chip" type="button" data-v="A level">A level only</button></div>
    <h3>Difficulty</h3>
    <div class="chips" data-group="diff"><button class="chip" type="button" data-v="" aria-pressed="true">Any</button><button class="chip" type="button" data-v="rated">Rated only</button><button class="chip" type="button" data-v="Hard">Hard</button><button class="chip" type="button" data-v="Easy">Easy</button></div>
    <h3>How many</h3>
    <div class="chips" data-group="n"><button class="chip" type="button" data-v="5" aria-pressed="true">5</button><button class="chip" type="button" data-v="10">10</button><button class="chip" type="button" data-v="20">20</button></div>
    <h3>Timer</h3>
    <div class="chips" data-group="timer"><button class="chip" type="button" data-v="0" aria-pressed="true">None</button><button class="chip" type="button" data-v="1">Exam pace (1.2 min per mark)</button></div>
    <div><button class="btn btn-accent" type="button" id="start">Start</button> <span class="muted" id="count"></span></div>
  </div>

  <div id="play" hidden>
    <div class="playbar"><span id="progress"></span><span class="timer" id="timer"></span><button class="btn" type="button" id="next">Next</button></div>
    <div id="card"></div>
  </div>

  <div id="done" hidden>
    <h2>Your round</h2>
    <div class="summary" id="summary"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="again">Another round</button><a class="btn" href="/specification/">See the checklist</a><button class="btn" type="button" id="clear">Clear all my scores</button></div>
  </div>

  <script>
    import { loadBank, card, saveScore, clearScores, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    let bank = null, queue = [], i = 0, earnedThis = 0, totalThis = 0, timer = null, secs = 0, roundScores = {};
    const sel = { topics: new Set(), level: '', diff: '', n: 5, timer: 0 };

    document.querySelectorAll('[data-topic]').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); on ? sel.topics.add(b.dataset.topic) : sel.topics.delete(b.dataset.topic); count(); }));
    document.querySelectorAll('[data-all]').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('[data-topic]').forEach((t) => { const on = b.dataset.all && t.closest('[data-strand]').dataset.strand === b.dataset.all; t.setAttribute('aria-pressed', String(on)); on ? sel.topics.add(t.dataset.topic) : sel.topics.delete(t.dataset.topic); }); count(); }));
    document.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); const k = g.dataset.group; sel[k] = k === 'n' || k === 'timer' ? Number(b.dataset.v) : b.dataset.v; count(); })));

    function pool() {
      if (!bank) return [];
      return bank.q.filter((q) => (!sel.topics.size || q.t.some((t) => sel.topics.has(t))) && (!sel.level || q.l === sel.level) && (!sel.diff || (sel.diff === 'rated' ? !!q.d : q.d === sel.diff)) && q.c);
    }
    function count() { const n = pool().length; $('#count').textContent = bank ? `${n} question${n === 1 ? '' : 's'} match` : 'Loading…'; }
    loadBank().then((b) => { bank = b; count(); });

    $('#start').addEventListener('click', () => {
      const p = shuffle(pool()).slice(0, sel.n);
      if (!p.length) { $('#count').textContent = 'Nothing matches; pick more topics.'; return; }
      queue = p; i = 0; roundScores = {};
      $('#setup').hidden = true; $('#done').hidden = true; $('#play').hidden = false;
      secs = sel.timer ? Math.round(queue.reduce((a, q) => a + q.m, 0) * 72) : 0;
      if (timer) clearInterval(timer);
      if (secs) { timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); $('#timer').textContent = fmtTime(secs); } else $('#timer').textContent = '';
      show();
    });
    function show() {
      const q = queue[i]; earnedThis = null;
      $('#progress').textContent = `Question ${i + 1} of ${queue.length}`;
      $('#next').textContent = i === queue.length - 1 ? 'Finish' : 'Next';
      const holder = $('#card'); holder.innerHTML = '';
      holder.appendChild(card(q, { mark: true, onMark: (m) => { earnedThis = m; } }));
      window.scrollTo({ top: holder.offsetTop - 120, behavior: 'smooth' });
    }
    $('#next').addEventListener('click', () => {
      const q = queue[i];
      if (earnedThis !== null) { saveScore(q.t, earnedThis, q.m, q.id); for (const t of q.t) { const r = roundScores[t] || { e: 0, m: 0 }; r.e += earnedThis; r.m += q.m; roundScores[t] = r; } }
      if (i < queue.length - 1) { i++; show(); } else finish();
    });
    function finish() {
      if (timer) clearInterval(timer);
      $('#play').hidden = true; $('#done').hidden = false;
      const names = Object.fromEntries(bank.topics.map((t) => [t.slug, t.name]));
      const rows = Object.entries(roundScores);
      $('#summary').innerHTML = rows.length ? rows.map(([t, r]) => `<div><a href="/questions/${t}/">${names[t] || t}</a>: ${r.e}/${r.m}<div class="bar"><i style="width:${r.m ? Math.round(100 * r.e / r.m) : 0}%"></i></div></div>`).join('') : '<p class="muted">You didn\'t mark any questions this round. Open the mark scheme and tap the marks you earned to keep a score.</p>';
    }
    $('#again').addEventListener('click', () => { $('#done').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
    $('#clear').addEventListener('click', () => { clearScores(); $('#summary').innerHTML = '<p class="muted">Scores cleared.</p>'; });
  </script>
</Base>
