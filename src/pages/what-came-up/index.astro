---
import Base from '../../layouts/Base.astro';
import { allPapers, byId, topicByslug } from '../../lib/data';
const latest = allPapers.sort((a, b) => b.year - a.year)[0].series;
const papers = allPapers.filter((p) => p.series === latest).sort((a, b) => a.spec.localeCompare(b.spec) || a.id.localeCompare(b.id));
---
<Base title={`What came up in Edexcel A-level Further Maths ${latest}: every question by topic and marks`} description={`Question-by-question summary of the ${latest} Edexcel Further Maths papers: topics, marks and difficulty.`} context="what-came-up" leadLine="Want next summer's papers gone through topic by topic? Message us.">
  <h1>What came up: {latest}</h1>
  <p class="muted">{latest} is the latest series the board has released publicly (Pearson keeps papers secure for schools for about a year, so June 2026 is expected in autumn 2027).</p>
  <p>The most recent series, question by question, with the examiner-report difficulty where one was given. The <a href="/analysis/">analysis page</a> shows how this compares with earlier years.</p>
  {papers.map((p) => { const qs = p.questions.map((id) => byId.get(id)).filter(Boolean); return <>
    <h2><a href={`/past-papers/${p.slug}/`}>{p.qual === 'AS' ? 'AS ' : ''}{p.name}</a> <span class="muted">({p.total} marks)</span></h2>
    <div class="table-wrap"><table><thead><tr><th>Q</th><th>Topic</th><th>Marks</th><th>Difficulty</th></tr></thead>
      <tbody>{qs.map((q) => <tr><td><a href={`/past-papers/${p.slug}/#${q.id}`}>{q.question}</a></td><td>{q.topics.map((t, i) => <>{i ? ', ' : ''}<a href={`/questions/${t}/`}>{topicByslug.get(t)?.name ?? t}</a></>)}</td><td>{q.marks}</td><td>{q.difficulty ? <span class={`pill pill-${q.difficulty.toLowerCase()}`}>{q.difficulty}</span> : <span class="muted">—</span>}</td></tr>)}</tbody></table></div>
  </>; })}
  <p class="muted">This page regenerates when the next series is added.</p>
</Base>
