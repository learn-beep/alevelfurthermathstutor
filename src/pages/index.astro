---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers } from '../lib/data';
import Icon from '../components/Icon.astro';
const featured = ['complex-numbers','proof-by-induction','matrices','hyperbolic-functions','polar-coordinates','second-order-differential-equations','maclaurin-series','volumes-of-revolution','vectors-lines-and-planes','conic-sections','chi-squared-tests','momentum-and-impulse','critical-path-analysis','game-theory'];
const top = featured.map((s) => allTopics.find((t) => t.slug === s)).filter(Boolean);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, strand: t.strand, parts: t.parts }));
---
<Base title="Edexcel A-level Further Maths: past-paper questions by topic, mark schemes and tutors" description="Every Edexcel AS and A-level Further Maths (9FM0, 8FM0) past-paper question since 2018, by topic, with mark schemes and examiner comments. Core Pure and all eight options. Free, with an online Further Maths tutor." context="home" leadLine="Further Maths tutors are hard to find. Tell us the year, the options and the target grade and we'll set up a trial lesson.">
  <h1>Edexcel Further Maths, one topic at a time</h1>
  <p>{allQuestions.length.toLocaleString()} question parts from all {allPapers.length} Edexcel Further Maths papers since 2018, Core Pure and all eight options, sorted by topic, with the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">Pearson Edexcel A-level Further Mathematics 9FM0 and AS 8FM0 (UK). Not the International A-level (IAL).</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/mock/"><Icon name="timer" />Mini-mock</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/formula-booklet/"><Icon name="sigma" />Formula booklet</a>
    <a href="/specification/"><Icon name="checklist" />Spec checklist</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="e.g. hyperbolic functions" autocomplete="off" />

  <h2 class="strand-head">Most searched topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand">{t.parts} parts</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every paper with a question-by-question table</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time; mark yourself</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A timed paper from real questions, playable or printable</span></a>
    <a class="tile-card" href="/formula-booklet/"><Icon name="sigma" /><strong>Formula booklet</strong><span>What's given, what you must learn, and a self-test</span></a>
    <a class="tile-card" href="/options/"><Icon name="book" /><strong>Choosing options</strong><span>The eight option papers, the legal pairs and what each covers</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every statement, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks by topic since 2019, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculator and the 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/planner/"><Icon name="lightbulb" /><strong>Revision planner</strong><span>A week-by-week plan to Core Pure 1 from your weak topics</span></a>
    <a class="tile-card" href="/hardest-questions/"><Icon name="flask" /><strong>Hardest questions</strong><span>The rated parts where fewer than 35% of marks were scored</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Tutors</strong><span>Emma: A-level Maths and Further Maths specialist, online</span></a>
  </div>

  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('fmalt-spec') || '{}'), scores = JSON.parse(localStorage.getItem('fmalt-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} parts</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. Try a shorter word, or <a href="/questions/">browse all topics</a>.</li>';
    });
  </script>
</Base>
