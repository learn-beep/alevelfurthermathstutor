---
import Base from '../../layouts/Base.astro';
import exams from '../../data/exams.json';
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const year = exams.series.split(' ')[1];
---
<Base title={`Edexcel Further Maths exam dates ${year} (9FM0 and 8FM0) with countdown`} description={`Every Edexcel A-level and AS Further Maths paper date for ${exams.series}, Core Pure and all eight options, from Pearson's final timetable, with a countdown to Core Pure 1.`} context="exam-dates" leadLine="Weeks to go and a topic you still can't do? Message us.">
  <h1>Exam dates: {exams.series}</h1>
  <p class="muted">Days until A-level Paper 1 (Core Pure 1)</p>
  <p class="countdown" id="countdown" data-date={exams.alevel[0].date}>—</p>
  <h2>A level (9FM0)</h2>
  <p>You sit Papers 1 and 2 plus the two option papers you are entered for. All four Paper 4 options are on the same afternoon (Monday 21 June); no allowed combination includes two of them, so nobody sits two papers that day. Check your entry with your school.</p>
  <div class="table-wrap"><table>
    <thead><tr><th>Paper</th><th>Date</th><th>Session</th><th>Length</th></tr></thead>
    <tbody>{exams.alevel.map((e) => <tr><td>{e.name}<br /><span class="muted">{e.code}</span></td><td>{fmt(e.date)}</td><td>{e.session}</td><td>{e.length}</td></tr>)}</tbody>
  </table></div>
  <h2>AS (8FM0)</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Paper</th><th>Date</th><th>Session</th><th>Length</th></tr></thead>
    <tbody>{exams.as.map((e) => <tr><td>{e.name}<br /><span class="muted">{e.code}</span></td><td>{fmt(e.date)}</td><td>{e.session}</td><td>{e.length}</td></tr>)}</tbody>
  </table></div>
  <p class="muted">{exams.source}. Confirm times with your school: Pearson sets the session, your centre sets the start time.</p>
  <script>
    const el = document.getElementById('countdown');
    const target = new Date(el.dataset.date + 'T13:30:00+01:00');
    const days = Math.ceil((target - new Date()) / 86400000);
    el.textContent = days > 0 ? `${days} days` : days === 0 ? 'Today' : 'Done';
  </script>
</Base>
