---
import { cropsOn } from '../lib/site';
import Icon from './Icon.astro';
import { PEARSON_MATERIALS } from '../lib/data';
const { q, showTopics = false } = Astro.props;
const pillClass = q.difficulty ? `pill pill-${q.difficulty.toLowerCase()}` : '';
---
<article class="qcard" id={q.id} data-level={q.level} data-difficulty={q.difficulty || ''} data-year={String(q.year)}>
  <div class="meta">
    <strong>{q.series} · {q.level === 'AS' ? 'AS ' : ''}{q.paper} · Q{q.question}</strong>
    <span>{q.marks} mark{q.marks === 1 ? '' : 's'}</span>
    {q.difficulty && <span class={pillClass}>{q.difficulty}</span>}
    {showTopics && q.topics.map((t) => <a href={`/questions/${t}/`}>{t.replace(/-/g, ' ')}</a>)}
  </div>
  {cropsOn && q.crop
    ? <img class="crop" src={q.crop} alt={q.text} loading="lazy" decoding="async" />
    : <a class="crop-link" href={PEARSON_MATERIALS} rel="noopener">Open this paper on Pearson's site</a>}
  <div class="actions">
    {q.msCrop && cropsOn && <button class="btn" type="button" data-reveal="ms" aria-expanded="false"><Icon name="check" />Mark scheme</button>}
    {q.erText && <button class="btn" type="button" data-reveal="er" aria-expanded="false"><Icon name="comment" />Examiner's comment</button>}
    {q.mistakes?.length > 0 && <button class="btn" type="button" data-reveal="mc" aria-expanded="false"><Icon name="lightbulb" />Key points</button>}
  </div>
  {q.msCrop && cropsOn && <div class="reveal" data-panel="ms" hidden><h4>Mark scheme (whole question; this part is marked with the orange bar)</h4><div class="ms-wrap"><img class="crop" data-src={q.msCrop} alt={`Mark scheme for ${q.series} ${q.paper} question ${q.question}`} decoding="async" />{q.msBands?.map((b) => <span class="ms-band" style={`top:${(b[0] * 100).toFixed(2)}%;height:${((b[1] - b[0]) * 100).toFixed(2)}%`}></span>)}</div></div>}
  {q.erText && <div class="reveal" data-panel="er" hidden><h4>Examiner's comment</h4><p>{q.erText}</p></div>}
  {q.mistakes?.length > 0 && <div class="reveal" data-panel="mc" hidden><h4>Key points from the mark scheme and examiner's report</h4><ul>{q.mistakes.map((m) => <li>{m}</li>)}</ul></div>}
</article>
<script>
  document.querySelectorAll('.qcard').forEach((card) => {
    card.querySelectorAll('[data-reveal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-reveal');
        const panel = card.querySelector(`[data-panel="${key}"]`);
        if (!panel) return;
        const img = panel.querySelector('img[data-src]');
        if (img) { img.src = img.getAttribute('data-src'); img.removeAttribute('data-src'); }
        const open = panel.hasAttribute('hidden');
        panel.toggleAttribute('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
      });
    });
  });
</script>
